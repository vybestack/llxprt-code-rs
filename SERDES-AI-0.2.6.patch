+        assert_eq!(
+            map_terminal_reason("provider-added-value", &[("stop", FinishReason::Stop)]),
+            FinishReason::Other("provider-added-value".to_string())
+        );
+        assert_eq!(
+            map_terminal_reason("stop", &[("stop", FinishReason::Stop)]),
+            FinishReason::Stop
+        );
+    }
+}
