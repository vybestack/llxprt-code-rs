+                .header("x-api-key", "header-secret")
+                .body("private-request-body")
+                .send()
+                .await
+                .unwrap();
+            assert_eq!(response.status().as_u16(), status);
+        }
+        target_thread.join().unwrap();
+        assert_eq!(requests.load(Ordering::SeqCst), 0);
