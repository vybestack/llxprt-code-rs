-    /// Execute the search.
-    async fn search(&self, query: &str) -> Result<Vec<DuckDuckGoResult>, ToolError> {
-        let url = format!(
-            "https://api.duckduckgo.com/?q={}&format=json&no_html=1&skip_disambig=1",
-            urlencoding::encode(query)
-        );
-
-        let response = self
