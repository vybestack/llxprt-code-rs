+            error_code: Some("code-secret-marker".to_string()),
+            retryable: false,
+            retry_after: None,
+        };
+        let debug = format!("{err:?}");
+        let display = err.to_string();
+        for marker in [
+            "body-secret",
+            "header-secret",
+            "message-secret",
+            "code-secret",
+        ] {
+            assert!(!debug.contains(marker));
+            assert!(!display.contains(marker));
+        }
+        assert!(debug.contains("[redacted]"));
+    }
 }
