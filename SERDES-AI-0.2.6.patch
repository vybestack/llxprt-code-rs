-type FakeWs = WebSocketStream<tokio::net::TcpStream>;
-
-/// Accept one websocket connection.
-async fn accept_ws(listener: &TcpListener) -> FakeWs {
-    let (stream, _) = listener.accept().await.unwrap();
-    accept_async(stream).await.unwrap()
-}
