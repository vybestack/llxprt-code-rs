{
  "version": 1,
  "provider": "openai",
  "model": "z-ai/glm-5.2",
  "modelParams": {
    "max_tokens": 32000,
    "temperature": 1,
    "top_p": 0.95,
    "provider": {
      "order": [
        "Parasail"
      ],
      "allow_fallbacks": false
    }
  },
  "ephemeralSettings": {
    "auth-key-name": "<redacted-credential>",
    "base-url": "https://openrouter.ai/api/v1",
    "context-limit": 262000
  }
}
