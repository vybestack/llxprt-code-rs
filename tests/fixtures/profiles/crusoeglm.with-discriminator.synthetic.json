{
  "version": 1,
  "provider": "openai",
  "model": "zai/GLM-5.2",
  "modelParams": {
    "temperature": 0.3,
    "top_p": 0.9,
    "chat_template_kwargs": {
      "enable_thinking": false
    }
  },
  "ephemeralSettings": {
    "base-url": "https://api.inference.crusoecloud.com/v1/",
    "reasoning.enabled": true,
    "reasoning.effort": "high",
    "prompt-caching": "24h",
    "context-limit": 262000
  }
}
