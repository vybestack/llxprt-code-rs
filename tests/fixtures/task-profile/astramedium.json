{
  "version": 1,
  "provider": "codex",
  "model": "gpt-6-astra",
  "modelParams": {
    "maxOutputTokens": 40000
  },
  "ephemeralSettings": {
    "base-url": "https://chatgpt.com/backend-api/codex",
    "reasoning.enabled": true,
    "reasoning.effort": "medium",
    "reasoning.adaptiveThinking": true,
    "reasoning.includeInResponse": true,
    "reasoning.includeInContext": true,
    "reasoning.stripFromContext": "none",
    "reasoning.summary": "auto",
    "text.verbosity": "medium",
    "prompt-caching": "24h",
    "context-limit": 300000,
    "maxTurnsPerPrompt": -1,
    "loopDetectionEnabled": false,
    "emojifilter": "auto",
    "tools.disabled": [
      "google_web_fetch",
      "google_web_search"
    ],
    "stream-idle-timeout-ms": 0,
    "task-default-timeout-seconds": 2700,
    "task-max-timeout-seconds": -1,
    "image-resize.maxLongEdge": 2048,
    "image-resize.maxShortEdge": 2048,
    "image-resize.maxPixels": 1572864,
    "shell-default-timeout-seconds": 2700,
    "shell-max-timeout-seconds": -1,
    "stream-first-response-timeout-ms": -1
  }
}
