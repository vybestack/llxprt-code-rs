  "$id": "https://github.com/vybestack/llxprt-code-rs/schemas/stdout-envelope-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "description": "A completed turn.",
      "properties": {
        "attempt": {
          "description": "Attempts are 1-based.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "branch": {
          "type": "boolean"
        },
        "branch_id": {
          "type": "string"
        },
        "budget_exhausted": {
          "type": "boolean"
        },
        "declared_tool_calls": {
          "description": "Declared tool-call budget; `-1` means unlimited.",
          "format": "int64",
          "minimum": -1,
          "type": "integer"
        },
        "output_caps": {
          "$ref": "#/$defs/OutputCaps",
          "default": {
            "shell": 32768,
            "tool": 16777216,
            "turn": 16777216
          },
          "description": "Resolved output caps (issue 77): per-result shell/tool caps and the aggregate\nper-turn tool-output cap."
        },
        "prompt_digest": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        },
        "retry_attempts": {
          "description": "Transport reattempts issued in this invocation, excluding initial calls.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_dir": {
          "type": "string"
        },
        "session_id": {
          "description": "Safe session component: ASCII letters, digits, underscore, or hyphen.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Telemetry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Strict, versioned observations; setup failures may have none."
        },
        "terminal_outcome": {
          "description": "Terminal context-store outcome declared by the runtime, when one exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "zero_call_tail": {
          "description": "Consecutive trailing assistant rounds that parsed to zero tool calls, including\nthe final summary round (so a healthy wrap-up reports `1`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "session_id",
        "session_dir",
        "turn",
        "attempt",
        "branch_id",
        "branch",
        "replayed",
        "summary",
        "tool_calls",
        "declared_tool_calls",
        "budget_exhausted",
        "zero_call_tail",
        "retry_attempts",
        "prompt_digest",
        "output_caps"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "An invocation failure.",
      "properties": {
        "error": {
          "$ref": "#/$defs/EnvelopeError"
        },
        "session_id": {
          "description": "Safe session component: ASCII letters, digits, underscore, or hyphen.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "status": {
          "const": "error",
          "type": "string"
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Telemetry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Strict, versioned observations; setup failures may have none."
        }
      },
      "required": [
        "status",
        "session_id",
        "error"
      ],
      "type": "object"
    }
  ],
  "description": "Structural serialized-output contract. Process exit agreement and relational semantic rules are enforced separately by the harness.",
  "title": "llxprt-code-rs stdout envelope v1"
}
