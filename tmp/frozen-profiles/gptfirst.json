{
  "version": 1,
  "type": "loadbalancer",
  "policy": "failover",
  "profiles": [
    "gpt56solhigh",
    "opusthinking"
  ],
  "contextLimit": 200000,
  "provider": "",
  "model": "",
  "modelParams": {
    "maxOutputTokens": 40000
  },
  "ephemeralSettings": {
    "reasoning": {
      "enabled": true,
      "effort": "high",
      "adaptiveThinking": true,
      "includeInResponse": true,
      "includeInContext": true,
      "stripFromContext": "none",
      "summary": "auto"
    },
    "prompt-caching": "24h",
    "maxTurnsPerPrompt": -1,
    "loopDetectionEnabled": false
  }
}
